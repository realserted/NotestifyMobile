# Copy this file to `.env` and fill in the values from your Supabase project:
# Supabase Dashboard -> Project Settings -> API
#
# These must use the EXPO_PUBLIC_ prefix so Expo inlines them into the client
# bundle. Restart the dev server (`npx expo start --clear`) after changing them.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# The `anon` / publishable key — NOT the service role key. Anything shipped in a
# mobile bundle is readable by users, so this key must stay RLS-protected.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Turnstile host page served by the Notestify web app, used only by the
# email/password path. Leave blank to hide that form's captcha (valid only if
# Supabase Auth also has CAPTCHA protection off). Google sign-in ignores this.
EXPO_PUBLIC_CAPTCHA_URL=https://www.notestify.com/mobile-captcha
