# Copy this file to `.env` and fill in the values from your Supabase project:
# Supabase Dashboard -> Project Settings -> API
#
# These must use the EXPO_PUBLIC_ prefix so Expo inlines them into the client
# bundle. Restart the dev server (`npx expo start --clear`) after changing them.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# The `anon` / publishable key — NOT the service role key. Anything shipped in a
# mobile bundle is readable by users, so this key must stay RLS-protected.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth, for native sign-in. Both come from Google Cloud Console:
#   APIs & Services -> Credentials
# Neither is a secret; they ship inside the app bundle.

# The existing Web client the notestify.com app uses. Supabase validates the
# ID token's audience against this, so it must match the one in
# Supabase -> Authentication -> Providers -> Google.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# A NEW iOS OAuth client, created against bundle ID com.notestify.mobile.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# The iOS client ID reversed, e.g. com.googleusercontent.apps.123-abc
# Required by the config plugin at build time.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
